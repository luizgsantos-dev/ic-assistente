# Copie para .env e preencha. O .env nunca vai para o git.

# Chave da API da Anthropic (console.anthropic.com). Necessária para perguntar, avaliar e
# transcrever PDFs escaneados. Ingestão e busca funcionam sem ela.
ANTHROPIC_API_KEY=

# Banco (o docker-compose.yml sobe o Postgres na porta 5433)
DATABASE_URL=postgresql+psycopg://ic:ic@127.0.0.1:5433/ic_assistant
POSTGRES_PASSWORD=ic

# Modelos. Para comparar custo e qualidade, troque e rode `ic avaliar`.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
JUDGE_MODEL=claude-opus-5-5
TRANSCRIPTION_MODEL=claude-opus-5-5

# Para onde o assistente encaminha quando não encontra a resposta
CONTATO_FALLBACK=cacomp@ic.ufmt.br
